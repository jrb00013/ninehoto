<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

  <ScrollView
      android:id="@+id/menu_scroll"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="80dp"
        android:paddingBottom="40dp"
        android:paddingHorizontal="24dp"
        android:gravity="center_horizontal">

      <ImageView
          android:layout_width="72dp"
          android:layout_height="72dp"
          android:src="@drawable/ic_launcher_fg"
          android:background="@color/ic_launcher_bg"
          android:contentDescription="@string/app_name" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          android:text="@string/app_name"
          android:textSize="32sp"
          android:textStyle="bold"
          android:textColor="#FFFFFFFF" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="@string/main_blurb"
          android:textColor="#AAFFFFFF"
          android:textSize="15sp"
          android:gravity="center_horizontal" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginTop="24dp"
          android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="←"
              android:textSize="24sp"
              android:textColor="#FFFF4444" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="delete"
              android:textSize="12sp"
              android:textColor="#FF888888" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="→"
              android:textSize="24sp"
              android:textColor="#FF44FF88" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="keep"
              android:textSize="12sp"
              android:textColor="#FF888888" />
        </LinearLayout>
      </LinearLayout>

      <TextView
          android:id="@+id/permission_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:textColor="#FFFF6B6B"
          android:textSize="14sp"
          android:gravity="center_horizontal"
          android:visibility="gone" />

      <Button
          android:id="@+id/start_button"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text="@string/start_cleaning"
          android:textSize="16sp" />

      <Button
          android:id="@+id/filter_button"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="@string/filter_label"
          android:textSize="14sp"
          style="?android:attr/borderlessButtonStyle"
          android:textColor="#AAFFFFFF" />

      <TextView
          android:id="@+id/cap_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:textColor="#66FFFFFF"
          android:textSize="12sp"
          android:gravity="center_horizontal" />
    </LinearLayout>
  </ScrollView>

    <FrameLayout
        android:id="@+id/session_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

    <FrameLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="80dp">

      <androidx.cardview.widget.CardView
          android:id="@+id/card_wrapper"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_margin="8dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="8dp"
          app:cardBackgroundColor="#FF111111"
          xmlns:app="http://schemas.android.com/apk/res-auto">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

          <ImageView
              android:id="@+id/card_image"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:scaleType="fitCenter"
              android:contentDescription="@string/app_name" />

          <LinearLayout
              android:id="@+id/video_indicator"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="bottom|end"
              android:layout_margin="16dp"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:paddingHorizontal="10dp"
              android:paddingVertical="6dp"
              android:background="@drawable/video_badge_bg"
              android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/video_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
          </LinearLayout>

          <TextView
              android:id="@+id/file_size_text"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="bottom|start"
              android:layout_margin="16dp"
              android:paddingHorizontal="10dp"
              android:paddingVertical="4dp"
              android:textSize="12sp"
              android:textColor="#EEFFFFFF"
              android:background="@drawable/video_badge_bg"
              android:visibility="gone" />

          <TextView
              android:id="@+id/group_badge_text"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="top|start"
              android:layout_margin="12dp"
              android:paddingHorizontal="10dp"
              android:paddingVertical="4dp"
              android:textSize="12sp"
              android:textColor="#FFFFFFFF"
              android:background="@drawable/video_badge_bg"
              android:visibility="gone" />
        </FrameLayout>
      </androidx.cardview.widget.CardView>
    </FrameLayout>

    <TextView
        android:id="@+id/delete_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/delete_overlay"
        android:textColor="#FFFF4444"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:rotation="-15" />

    <TextView
        android:id="@+id/keep_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/keep_overlay"
        android:textColor="#FF44FF88"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:rotation="15" />

    <ProgressBar
        android:id="@+id/loading_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/delete_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF000000"
        android:visibility="gone">

      <ProgressBar
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:indeterminate="true" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:text="@string/deleting"
          android:textColor="#FFFFFFFF"
          android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp">

      <Button
          android:id="@+id/done_button"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/done" />

      <Button
          android:id="@+id/undo_button"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="@string/undo_label"
          android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:padding="16dp"
        android:background="#66000000">

      <TextView
          android:id="@+id/marked_text"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:textColor="#EEFFFFFF"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/remaining_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#AAFFFFFF"
          android:textSize="14sp" />
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
