# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4

[*.{swift}]
indent_size = 4
indent_style = space
max_line_length = 120

[{Makefile,*.sh}]
indent_style = tab

[*.cs]
indent_size = 4
trim_trailing_whitespace = true

[*.json]
indent_size = 2

[android/**]
indent_style = space
indent_size = 4
